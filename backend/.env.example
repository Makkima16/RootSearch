# ======================================
# Variables de entorno del backend (NestJS)
# ======================================

# ----------------------------
# Base de datos
# ----------------------------
MONGODB_URI=mongodb+srv://tu-usuario:tu-password@tu-cluster.mongodb.net/rootsearch?retryWrites=true&w=majority

# ----------------------------
# JWT
# ----------------------------
JWT_SECRET=your-super-secret-jwt-key

# ----------------------------
# Servidor
# ----------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ----------------------------
# Email
# ----------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-contrasena-app

# ----------------------------
# Google Drive (almacenamiento)
# ----------------------------
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_REFRESH_TOKEN=tu-google-refresh-token
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# ----------------------------
# Transcripción de audio
# ----------------------------
# LOCAL: servidor propio (Whisper/Ollama/LM Studio)
# CLOUD: OpenAI Whisper API
TRANSCRIPTION_MODE=LOCAL
LOCAL_TRANSCRIPTION_ENDPOINT=http://localhost:8000/api/transcribe

# ----------------------------
# Generación de contenido con IA
# ----------------------------
# LOCAL: LM Studio | CLOUD: OpenAI
CONTENT_GENERATION_MODE=LOCAL
LM_STUDIO_URL=http://localhost:1234

# Solo si TRANSCRIPTION_MODE=CLOUD o CONTENT_GENERATION_MODE=CLOUD
OPENAI_API_KEY=

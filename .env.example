# ============================================================
# RootSearch - Plantilla de variables de entorno
# ============================================================
# Uso local:
#   - Backend:  copia este archivo a backend/.env
#   - Frontend: copia frontend/.env.example a frontend/.env
# Uso con Docker Compose:
#   - Copia este archivo a .env en la raíz (infra/docker lo consume)
# ============================================================

# ----------------------------
# Base de datos (MongoDB)
# ----------------------------
MONGODB_URI=mongodb://rootsearch:rootsearch@localhost:27017/rootsearch?authSource=admin

# ----------------------------
# Servidor backend
# ----------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ----------------------------
# Autenticación
# ----------------------------
JWT_SECRET=cambia-este-secreto-en-produccion

# ----------------------------
# Frontend
# ----------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ----------------------------
# Email (verificación 2FA y recuperación)
# ----------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-contrasena-app

# ----------------------------
# Google Drive (almacenamiento de materiales)
# ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# ----------------------------
# Transcripción de audio
# ----------------------------
# LOCAL: servidor propio (Whisper/Ollama/LM Studio)
# CLOUD: OpenAI Whisper API
TRANSCRIPTION_MODE=LOCAL
LOCAL_TRANSCRIPTION_ENDPOINT=http://localhost:8000/api/transcribe

# ----------------------------
# Generación de contenido con IA
# ----------------------------
# LOCAL: LM Studio / Ollama | CLOUD: OpenAI
CONTENT_GENERATION_MODE=LOCAL
LM_STUDIO_URL=http://localhost:1234

# ----------------------------
# OpenAI (solo si usas modo CLOUD)
# ----------------------------
OPENAI_API_KEY=
